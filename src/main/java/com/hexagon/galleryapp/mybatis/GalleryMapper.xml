<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 실제 프로젝트 진행시 수많은 테이블마다 1:1로 대응하도록 DTO, DAO, Mybatis Mapper xml도 만들게 된다 
	이때 모든 Mybatis Mapper xml마다 insert라는 id를 중복해서 개발하면 추후 java언어가 xml 접근시 이름 중복으로 
	구분을 못하게 될 수 있으므로 mapper namespace속성을 이용하여 유일한 구분값으로 id 묶을수 있다 -->

<mapper namespace="com.hexagon.galleryapp.dto.Gallery">

	<!-- 지금까지 JDBC 연동 시 사용해왔던 JDBC 관련 코드들은 쿼리문보다 주변의 상투적코드가 더 양이 많았다(비효율) 따라서 
		Mybatis를 이요하면 개발자가 JDBC의 상투적 코드를 작성하지 않고 오직 쿼리문에 집중할 수 있다록 도와줌 주의)_ JDBC기술이 
		사라진게 아니라. Mybatis가 내부적으로 JDBC 코드를 대신 작성하는 원리 Mybatis와 같은 기술을 가리켜 SQL Mapper라 
		함 SQL Mapper란 SQL문과 java의 클래스를 자동으로 매핑시켜주기 때문이다 -->

	<!-- 게시물 한건 넣기 내부적으로 JDBC를 사용하기 때문에 insert에 사용되는 DTO를 이용하여 values값에 사용한다 
		따라서 바인드 변수 인 #{중괄호}에 들어갈 값들은 DTO의 멤버변수를 적으면 된다 -->
	<insert id="insert"
		parameterType="com.hexagon.galleryapp.dto.Gallery">
		insert into gallery(title, writer, content, original_name, filename)
		values(#{title}, #{writer}, #{content}, #{originalName}, #{filename})
	</insert>

<!-- resultMap은 다음과 같은 경우 사용됨
	1) 데이터베이스의 컬럼명과 java 객체의 멤버변수명이 일치하지 않을 경우 자동으로 매칭되지 않기 때문에, 개발자가 직접 resultMap에서 매칭을 시켜야 할 경우
	2) 조인을 위한 collection, associate 사용시
 -->
	<resultMap type="com.hexagon.galleryapp.dto.Gallery" id="galleryMap">
		<id column="gallery_id" property="galleryId"/><!-- pk컬럼값과 자바의 멤버변수와 매칭시킬지 결정 -->
		<result column="title" property="title"/>
		<result column="writer" property="writer"/>
		<result column="content" property="content"/>
		<result column="original_name" property="originalName"/>
		<result column="filename" property="filename"/>
		<result column="created_at" property="createdAt"/>
		<result column="hit" property="hit"/>
	</resultMap>
	
	<!-- 모든 게시물 가져오기 
		resultType에 대해 자칫 List를 반환한다고 혼동하면 안된다. mybatis에서의 resultType은 
		각 컬럼을 어느 DTO에 담을지 그 자료형을 결정하는 것임 만일 게시물의 수가 여러개 인 경우 자동으로 List로 반환됨.. 개발자가	별도의 명시는 하지 않는다 
		
		아래와 같이 resultMap을 명시하면 mybatis가 자동으로 매칭하는 것이 아니라, 개발자가 작성한 resultMap 태그에서 매핑이 발생함
	-->
	
	<select id="selectAll" resultMap="galleryMap">
		select gallery_id, title, writer, content, original_name, filename, hit,
		created_at
		from gallery order by gallery_id desc
	</select>

	<!-- 레코드 한건 가져오기 
		parameter가 객체형이 아닌 하나짜리 기본자료형일 경우 파라미터 타입만 명시하면 자동으로 매핑된다
		역시나 한건을 가져올때도 컬럼명과 java의 프로퍼티가 일치하는 경우가 몇개 있으므로, resultMap을 이용하여 수동으로 매핑하자
	-->
	<select id="select" parameterType="long" resultMap="galleryMap"> 
		select gallery_id, title, writer, content, original_name, filename, hit, created_at
		from gallery
		where gallery_id = #{gallery_id}
	</select>

	<!-- 한건 수정하기 
		바인드 변수 #{} 안에 들어갈 값은? java DTO 클래스의 멤버변수인 property 명을 넣으면 됨
		이 쿼리를 호출한 자는 int형을 반환해 감
	-->
	<update id="update" parameterType="com.hexagon.galleryapp.dto.Gallery">
		update gallery set title=#{title}, writer=#{writer}, content=#{content}, original_name=#{originalName}, filename=#{filename}
		where gallery_id=#{galleryId}
	</update>

	<!-- 한건 삭제하기 -->
	<delete id="delete" parameterType="long">
		delete from gallery where gallery_id=#{galleryId}
	</delete>
	
	
</mapper>